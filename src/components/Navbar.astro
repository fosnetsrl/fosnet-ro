---
import { Icon } from "astro-icon/components";
import logo from "../assets/logo.png";
import { links } from "../data/home";

const currentPath = Astro.url.pathname;
---

<header
  class="sticky top-0 z-50 border-b border-border/60 bg-background/80 backdrop-blur"
>
  <div
    class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-6 py-3"
  >
    <a
      href="/"
      class="flex items-center gap-2 font-display text-xl font-bold text-foreground"
    >
      <img src={logo.src} alt="Foșnet" width="48px" height="48px" />
      <span class="font-display text-2xl font-bold text-secondary-foreground"
        >Foșnet</span
      >
    </a>

    <nav class="hidden md:flex items-center gap-1">
      {
        links.map((link) => (
          <a
            href={link.href}
            class={`text-sm font-normal transition-colors hover:text-primary p-2 rounded-2xl ${
              currentPath === link.href
                ? "text-primary border border-primary"
                : "text-muted-foreground"
            }`}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <a
      href="tel:+15550102288"
      class="hidden md:inline-flex items-center gap-2 rounded-full btn-hero px-5 py-2.5 text-sm font-semibold"
    >
      <Icon name={"lucide:phone"} /> Sună Acum
    </a>

    <button
      id="menu-button"
      class="grid h-10 w-10 place-items-center rounded-full border border-border md:hidden"
      aria-label="Toggle menu"
    >
      <Icon name={"lucide:menu"} />
    </button>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-t border-border bg-background md:hidden"
  >
    <div class="flex flex-col gap-1 px-6 py-4">
      {
        links.map((link) => (
          <a
            href={link.href}
            class={`rounded-lg px-3 py-2 text-sm font-medium ${
              currentPath === link.href
                ? "bg-secondary text-primary"
                : "text-foreground hover:bg-secondary"
            }`}
          >
            {link.label}
          </a>
        ))
      }

      <a
        href="tel:+15550102288"
        class="mt-2 inline-flex items-center justify-center gap-2 rounded-full btn-hero px-5 py-3 text-sm font-semibold"
      >
        <Icon name={"lucide:phone"} /> Apeleaza 0700-000-000
      </a>
    </div>
  </div>
</header>

<script>
  const button = document.getElementById("menu-button");
  const menu = document.getElementById("mobile-menu");

  button?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");

    button.textContent = menu?.classList.contains("hidden") ? "☰" : "✕";
  });
</script>
