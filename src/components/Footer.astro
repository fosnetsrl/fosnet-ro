---
import { links } from "../data/home";
import { Icon } from "astro-icon/components";
import logo from "../assets/logo.png";
---

<footer class="border-t border-border bg-secondary/40">
  <div class="mx-auto grid max-w-7xl gap-10 px-6 py-16 md:grid-cols-4">
    <div>
      <div class="flex items-center gap-2 font-display text-xl font-bold">
        <img src={logo.src} alt="Foșnet" width="48px" height="48px" />
        <span class="font-display text-2xl font-bold text-secondary-foreground"
          >Foșnet</span
        >
      </div>

      <p class="mt-4 max-w-xs text-sm text-muted-foreground">
        Îngrijim și amenajăm grădini în Cluj-Napoca și împrejurimi, de la gazon
        și plante până la arbori și întreținere sezonieră.
      </p>

      <!-- <p class="mt-4 text-sm text-muted-foreground">
        Rooted in craft. Trusted with your outdoor space since 2011.
      </p> -->

      <!-- <div class="mt-5 flex gap-3">
        <a
          href="#"
          class="grid h-10 w-10 place-items-center rounded-full border border-border bg-background hover:border-primary hover:text-primary transition-colors"
        >
          Facebook
        </a>

        <a
          href="#"
          class="grid h-10 w-10 place-items-center rounded-full border border-border bg-background hover:border-primary hover:text-primary transition-colors"
        >
          Instagram
        </a>

        <a
          href="#"
          class="grid h-10 w-10 place-items-center rounded-full border border-border bg-background hover:border-primary hover:text-primary transition-colors"
        >
          Twitter
        </a>
      </div> -->
    </div>

    <div>
      <p class="text-sm font-semibold">Navigare</p>

      <ul class="mt-4 space-y-2 text-sm text-muted-foreground">
        {
          links.map((item) => (
            <li>
              <a href={item.href} class="hover:text-primary">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold">Contact</p>

      <ul class="mt-4 space-y-3 text-sm text-muted-foreground">
        <li>
          <a
            href="tel:+40770700524"
            class="flex items-center gap-2 hover:text-primary"
          >
            <Icon name={"lucide:phone"} class="size-4 shrink-0" /> 0770-700-524
          </a>
        </li>

        <li>
          <a
            href="mailto:fosnetsrl@gmail.com"
            class="flex items-center gap-2 hover:text-primary"
          >
            <Icon name={"lucide:mail"} class="size-4 shrink-0" /> fosnetsrl@gmail.com
          </a>
        </li>

        <li class="flex items-center gap-2">
          <Icon name={"lucide:pin"} class="size-4 shrink-0" /> Cluj, Sălaj și împrejurimi
        </li>
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold">Program</p>

      <ul class="mt-4 space-y-2 text-sm text-muted-foreground">
        <li>Luni-Duminica</li>
        <li>Pe bază de programare</li>
      </ul>
    </div>
  </div>

  <div
    class="border-t border-border py-6 text-center text-xs text-muted-foreground"
  >
    © {new Date().getFullYear()} Foșnet · Toate drepturile rezervate.
  </div>
</footer>
