---
const navigation = [
  { href: "/", label: "Home" },
  { href: "/services", label: "Services" },
  { href: "/about", label: "About" },
  { href: "/portfolio", label: "Portfolio" },
  { href: "/contact", label: "Contact" },
];
import { Icon } from "astro-icon/components";
import logo from "../assets/logo.png";
---

<footer class="mt-24 border-t border-border bg-secondary/40">
  <div class="mx-auto grid max-w-7xl gap-10 px-6 py-16 md:grid-cols-4">
    <div>
      <div class="flex items-center gap-2 font-display text-xl font-bold">
        <img src={logo.src} alt="Foșnet" width="48px" height="48px" />
        <span class="font-display text-2xl font-bold text-secondary-foreground"
          >Foșnet</span
        >
      </div>

      <p class="mt-4 text-sm text-muted-foreground">
        Rooted in craft. Trusted with your outdoor space since 2011.
      </p>

      <div class="mt-5 flex gap-3">
        <a
          href="#"
          class="grid h-10 w-10 place-items-center rounded-full border border-border bg-background hover:border-primary hover:text-primary transition-colors"
        >
          Facebook
        </a>

        <a
          href="#"
          class="grid h-10 w-10 place-items-center rounded-full border border-border bg-background hover:border-primary hover:text-primary transition-colors"
        >
          Instagram
        </a>

        <a
          href="#"
          class="grid h-10 w-10 place-items-center rounded-full border border-border bg-background hover:border-primary hover:text-primary transition-colors"
        >
          Twitter
        </a>
      </div>
    </div>

    <div>
      <p class="text-sm font-semibold">Navigate</p>

      <ul class="mt-4 space-y-2 text-sm text-muted-foreground">
        {
          navigation.map((item) => (
            <li>
              <a href={item.href} class="hover:text-primary">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold">Contact</p>

      <ul class="mt-4 space-y-3 text-sm text-muted-foreground">
        <li>
          <a href="tel:+15550102288" class="hover:text-primary">
            <Icon name={"lucide:phone"} /> (555) 010-2288
          </a>
        </li>

        <li>
          <a href="mailto:hello@verdantcare.com" class="hover:text-primary">
            <Icon name={"lucide:mail"} /> hello@verdantcare.com
          </a>
        </li>

        <li><Icon name={"lucide:pin"} /> Greater Portland Area</li>
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold">Hours</p>

      <ul class="mt-4 space-y-2 text-sm text-muted-foreground">
        <li>Mon-Fri · 7:00 - 18:00</li>
        <li>Saturday · 8:00 - 15:00</li>
        <li>Sunday · Closed</li>
      </ul>
    </div>
  </div>

  <div
    class="border-t border-border py-6 text-center text-xs text-muted-foreground"
  >
    © {new Date().getFullYear()} Foșnet · All rights reserved.
  </div>
</footer>
