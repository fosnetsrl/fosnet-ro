---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import content from "../content/services.json";
---

<Layout title={content.meta.title} description={content.meta.description}>
  <section class="mx-auto max-w-7xl px-6 py-24">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-primary">
        {content.hero.label}
      </p>

      <h1 class="mt-3 font-display text-5xl font-bold md:text-6xl">
        {content.hero.title}
      </h1>

      <p class="mt-6 text-lg text-muted-foreground">
        {content.hero.description}
      </p>
    </div>

    <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        content.servicesDescription.map((service) => (
          <article
            class="group rounded-3xl border border-border bg-card p-8 transition-all hover:-translate-y-1"
            style="box-shadow: var(--shadow-soft)"
          >
            <div class="text-3xl grid h-12 w-12 place-items-center rounded-2xl bg-primary/10 text-primary transition-colors group-hover:bg-primary group-hover:text-primary-foreground">
              <Icon name={service.icon} />
            </div>

            <h2 class="mt-5 font-display text-3xl font-semibold">
              {service.title}
            </h2>

            <p class="mt-4 text-muted-foreground">{service.description}</p>

            <ul class="mt-6 space-y-3">
              {service.features.map((feature) => (
                <li class="flex gap-3">
                  <span class="text-primary flex flex-col justify-center">
                    <Icon name={"lucide:check-check"} />
                  </span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <section class="bg-secondary/40 py-24">
    <div class="mx-auto max-w-5xl px-6 text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-primary">
        {content.custom.label}
      </p>

      <h2 class="mt-3 font-display text-4xl font-bold">
        {content.custom.title}
      </h2>

      <p class="mx-auto mt-6 max-w-2xl text-lg text-muted-foreground">
        {content.custom.description}
      </p>

      <a
        href="/contact"
        class="mt-10 inline-flex rounded-full btn-hero px-8 py-4 font-semibold"
      >
        {content.custom.button}
      </a>
    </div>
  </section>
</Layout>
