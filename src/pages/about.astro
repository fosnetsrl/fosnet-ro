---
import Layout from "../layouts/Layout.astro";
import team from "../assets/team.jpg";
import { Icon } from "astro-icon/components";
import content from "../content/about.json";
---

<Layout title={content.meta.title} description={content.meta.description}>
  <section
    class="mx-auto grid max-w-7xl gap-14 px-6 py-24 md:grid-cols-1 md:items-center"
  >
    <div>
      <p class="text-sm font-semibold uppercase tracking-widest text-primary">
        {content.story.label}
      </p>

      <h1 class="mt-3 font-display text-5xl font-bold md:text-6xl">
        {content.story.title}
      </h1>

      {
        content.story.paragraphs.map((paragraph, index) => (
          <p
            class={
              index === 0
                ? "mt-6 text-lg text-muted-foreground"
                : "mt-4 text-lg text-muted-foreground"
            }
          >
            {paragraph}
          </p>
        ))
      }
      <div class="mt-8 grid grid-cols-3 gap-6">
        {
          content.stats.map((stat) => (
            <div>
              <div class="font-display text-3xl font-bold text-primary">
                {stat.number}
              </div>

              <div class="text-sm text-muted-foreground">{stat.label}</div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- <div class="relative">
      <img
        src={team.src}
        alt={content.story.imageAlt}
        width="1600"
        height="1000"
        class="w-full rounded-[2rem] object-cover"
        style="box-shadow: var(--shadow-elegant)"
      />
    </div> -->
  </section>

  <section class="bg-secondary/40 py-20">
    <div class="mx-auto max-w-7xl px-6">
      <div class="text-center">
        <p class="text-sm font-semibold uppercase tracking-widest text-primary">
          {content.value.label}
        </p>

        <h2 class="mt-2 font-display text-4xl font-bold">
          {content.value.title}
        </h2>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          content.values.map((value) => (
            <div
              class="rounded-3xl border border-border bg-card p-7"
              style="box-shadow: var(--shadow-soft)"
            >
              <div class="grid h-12 w-12 place-items-center rounded-2xl bg-primary/10 text-2xl">
                <Icon name={value.icon} />
              </div>

              <h3 class="mt-5 font-display text-xl font-semibold">
                {value.title}
              </h3>

              <p class="mt-3 text-sm text-muted-foreground">{value.desc}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-16 text-center">
        <a
          href="/contact"
          class="inline-flex items-center rounded-full btn-hero px-7 py-3.5 text-base font-semibold"
        >
          {content.value.button}
        </a>
      </div>
    </div>
  </section>
</Layout>
