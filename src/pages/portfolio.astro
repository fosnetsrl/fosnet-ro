---
import Layout from "../layouts/Layout.astro";
import hero from "../assets/hero.jpg";
import team from "../assets/team.jpg";
import content from "../content/portfolio.json";

const projectImages = {
  hero,
  team,
} as const;

function getProjectImage(image: keyof typeof projectImages) {
  return projectImages[image];
}
---

<Layout title={content.meta.title} description={content.meta.description}>
  <section class="mx-auto max-w-7xl px-6 py-24">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-primary">
        {content.hero.label}
      </p>

      <h1 class="mt-3 font-display text-5xl font-bold md:text-6xl">
        {content.hero.title}
      </h1>

      <p class="mt-6 text-lg text-muted-foreground">
        {content.hero.description}
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 pb-24">
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        content.projects.map((project) => (
          <article
            class="group overflow-hidden rounded-3xl border border-border bg-card"
            style="box-shadow: var(--shadow-soft)"
          >
            <div class="overflow-hidden">
              <img
                src={
                  getProjectImage(project.image as keyof typeof projectImages)
                    .src
                }
                alt={project.title}
                class="h-72 w-full object-cover transition duration-500 group-hover:scale-110"
              />
            </div>

            <div class="p-6">
              <span class="text-sm font-semibold uppercase tracking-widest text-primary">
                {project.category}
              </span>

              <h2 class="mt-3 font-display text-2xl font-semibold">
                {project.title}
              </h2>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="bg-secondary/40 py-24">
    <div class="mx-auto max-w-4xl px-6 text-center">
      <h2 class="font-display text-4xl font-bold">
        {content.cta.title}
      </h2>

      <p class="mx-auto mt-6 max-w-2xl text-lg text-muted-foreground">
        {content.cta.description}
      </p>

      <a
        href="/contact"
        class="mt-10 inline-flex rounded-full btn-hero px-8 py-4 font-semibold"
      >
        {content.cta.button}
      </a>
    </div>
  </section>
</Layout>
